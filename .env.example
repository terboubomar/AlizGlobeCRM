DATABASE_URL=postgresql://aliz:localdev@127.0.0.1:54329/aliz
REDIS_URL=redis://127.0.0.1:6389
APP_ORIGIN=http://localhost:3000
API_PORT=4000
DEMO_MODE=true
# Optional sample complaints/refunds; leave off to keep the case workspace empty.
SEED_DEMO_USERS=false
SEED_DEMO_CASES=false
# Generate each independent 32-byte hex key with: openssl rand -hex 32
PII_KEY=
PHONE_HASH_KEY=
# Required in production; JWT must include amr=mfa and sub mapped to enabled DB user.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
PUBLIC_INTAKE_ENABLED=false
FINANCE_POLICY_APPROVED=false
FINANCE_APPROVAL_LIMIT_MINOR=
# Absolute path to approved ClamAV scanner binary for non-demo uploads.
MALWARE_SCANNER=
UPLOAD_DIR=.data/uploads

WORKER_MODE=bullmq

# Local email/password login. Provisioning enables this and generates the key.
# Production continues to require the configured OIDC/MFA identity provider.
LOCAL_PASSWORD_AUTH=false
AUTH_SESSION_KEY=

# WhatsApp complaint confirmations (Meta Cloud API). Keep disabled until configured.
# APP_ORIGIN must be the public HTTPS CRM URL, not localhost.
WHATSAPP_ENABLED=false
WHATSAPP_TEMPLATE_APPROVED=false
WHATSAPP_API_VERSION=v26.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TEMPLATE_NAME=aliz_complaint_received
WHATSAPP_TEMPLATE_LANGUAGE=ar

# Internal Telegram alerts. Enable only after registering the webhook.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# OIDC browser sign-in (production). Register /api/auth/oidc/callback at the provider.
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_TOKEN_AUTH_METHOD=client_secret_basic
OIDC_ACR_VALUES=
# Optional exact provider acr values that attest MFA, comma-separated. amr=mfa is always accepted.
OIDC_MFA_ACR_VALUES=
# Trust only your controlled proxy IPs/CIDRs; the edge must sanitize forwarding headers.
TRUSTED_PROXY_CIDRS=loopback

# Approved production SLA policy; no production defaults are silently applied.
SLA_POLICY_APPROVED=false
SLA_POLICY_VERSION=
SLA_P1_FIRST_MINUTES=
SLA_P1_ACK_MINUTES=
SLA_P2_FIRST_MINUTES=
SLA_P2_ACK_MINUTES=
SLA_P2_REMEDY_MINUTES=
SLA_P3_FIRST_MINUTES=
SLA_P3_ACK_MINUTES=
SLA_P3_REMEDY_MINUTES=
# Production ingress must overwrite X-Forwarded-For using the real socket client IP.
PROXY_HEADERS_SANITIZED=false

# Retention: erase personal data from closed cases after this many days (minimum 30).
# Leave empty to keep retention off. Production also needs Legal's approval flag.
RETENTION_CLOSED_CASE_DAYS=
RETENTION_POLICY_APPROVED=false

# One JSON log line per API request (route pattern, status, duration, request ID). Set false to turn off.
LOG_REQUESTS=true
